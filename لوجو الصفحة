<script>
  document.getElementById('year').textContent = new Date().getFullYear();
  document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => {
    const text = document.getElementById(button.dataset.copy).innerText;
    try { await navigator.clipboard.writeText(text); button.textContent = 'تم النسخ'; }
    catch { button.textContent = 'تعذر النسخ — حدّد النص وانسخه'; }
    setTimeout(() => button.textContent = 'نسخ النص', 2200);
  }));
  const search = document.getElementById('articleSearch');
  const cards = [...document.querySelectorAll('.article-card')];
  const count = document.getElementById('resultCount');
  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase(); let visible = 0;
    cards.forEach(card => { const match = (card.innerText + ' ' + card.dataset.search).toLowerCase().includes(q); card.classList.toggle('hidden', !match); if(match) visible++; });
    count.textContent = visible + ' مقالات';
  });

  // Load the 40 full Arabic texts from an open dataset. The modal keeps the visitor on this page.
  const hadithGrid = document.getElementById('hadithGrid');
  const hadithStatus = document.getElementById('hadithStatus');
  const hadithModal = document.getElementById('hadithModal');
  const hadithModalTitle = document.getElementById('hadithModalTitle');
  const hadithModalText = document.getElementById('hadithModalText');
  const hadithSource = document.getElementById('hadithSource');
  let nawawiHadiths = [];
  const datasetUrls = [
    'https://cdn.jsdelivr.net/gh/osamayy/40-hadith-nawawi-db@main/40-hadith-nawawi.json',
    'https://raw.githubusercontent.com/osamayy/40-hadith-nawawi-db/main/40-hadith-nawawi.json'
  ];
  function extractHadithText(item) {
    const raw = String(item.hadith || item.arab || item.arabic || '');
    return raw.replace(/^الحديث\s+(?:الأول|الثاني|الثالث|الرابع|الخامس|السادس|السابع|الثامن|التاسع|العاشر|الحادي عشر|الثاني عشر|الثالث عشر|الرابع عشر|الخامس عشر|السادس عشر|السابع عشر|الثامن عشر|التاسع عشر|العشرون|الحادي والعشرون|الثاني والعشرون|الثالث والعشرون|الرابع والعشرون|الخامس والعشرون|السادس والعشرون|السابع والعشرون|الثامن والعشرون|التاسع والعشرون|الثلاثون|الحادي والثلاثون|الثاني والثلاثون|الثالث والثلاثون|الرابع والثلاثون|الخامس والثلاثون|السادس والثلاثون|السابع والثلاثون|الثامن والثلاثون|التاسع والثلاثون|الأربعون|الأربعين)[^\n]*\n*/,'').trim();
  }
  function renderHadithCards() {
    hadithGrid.innerHTML = '';
    nawawiHadiths.forEach((item, index) => {
      const full = extractHadithText(item);
      const firstLine = String(item.hadith || '').split('\n')[0].trim() || `الحديث ${index + 1}`;
      const card = document.createElement('article');
      card.className = 'card hadith-card';
      const badge = document.createElement('span'); badge.className = 'pill'; badge.textContent = `الحديث ${index + 1}`;
      const heading = document.createElement('h3'); heading.textContent = firstLine;
      const preview = document.createElement('p'); preview.className = 'hadith-preview'; preview.textContent = full.slice(0, 190) + (full.length > 190 ? '…' : '');
      const button = document.createElement('button'); button.type = 'button'; button.className = 'hadith-open'; button.textContent = 'اقرأ الحديث كاملًا';
      button.addEventListener('click', () => {
        hadithModalTitle.textContent = firstLine;
        hadithModalText.textContent = full || 'تعذر تحميل نص هذا الحديث. أعد تحميل الصفحة وحاول مجددًا.';
        hadithModalText.setAttribute('dir','rtl');
        hadithSource.href = `https://sunnah.com/nawawi40/${index + 1}`;
        hadithModal.hidden = false;
        document.body.style.overflow = 'hidden';
      });
      card.append(badge, heading, preview, button);
      hadithGrid.appendChild(card);
    });
    hadithStatus.textContent = `تم تحميل ${nawawiHadiths.length} حديثًا بنصوصها الكاملة.`;
  }
  async function loadNawawiHadiths() {
    let lastError;
    for (const url of datasetUrls) {
      try {
        const response = await fetch(url, {cache:'no-cache'});
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        if (!Array.isArray(data) || data.length < 40) throw new Error('بيانات الأحاديث غير مكتملة');
        nawawiHadiths = data.slice(0, 40);
        renderHadithCards();
        return;
      } catch (error) { lastError = error; }
    }
    hadithStatus.textContent = 'تعذر تحميل الأحاديث من المصدر. تحقق من اتصال الإنترنت ثم حدّث الصفحة.';
    console.error('Hadith loading failed:', lastError);
  }
  function closeHadithModal() { hadithModal.hidden = true; document.body.style.overflow = ''; }
  document.getElementById('hadithClose').addEventListener('click', closeHadithModal);
  hadithModal.addEventListener('click', event => { if (event.target === hadithModal) closeHadithModal(); });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && !hadithModal.hidden) closeHadithModal(); });
  loadNawawiHadiths();

  // Language selector: set Google's translation cookie first, then reload so the
  // translation service can apply consistently on GitHub Pages.
  function googleTranslateElementInit() {
    if (window.google && google.translate) {
      new google.translate.TranslateElement({pageLanguage:'ar', includedLanguages:'ar,en,fr', autoDisplay:false}, 'google_translate_element');
    }
  }
  const siteLanguage = document.getElementById('siteLanguage');
  const languageStatus = document.getElementById('languageStatus');
  function setTranslateCookie(language) {
    const value = language === 'ar' ? '/ar/ar' : '/ar/' + language;
    document.cookie = 'googtrans=' + value + ';path=/;max-age=31536000;SameSite=Lax';
    // Also set on the current host; this helps some GitHub Pages browser setups.
    document.cookie = 'googtrans=' + value + ';path=/;domain=' + location.hostname + ';max-age=31536000;SameSite=Lax';
  }
  function syncLanguageChoice() {
    const match = document.cookie.match(/(?:^|;\s*)googtrans=\/ar\/(ar|en|fr)/);
    if (match) siteLanguage.value = match[1];
    document.documentElement.lang = siteLanguage.value;
    document.documentElement.dir = siteLanguage.value === 'ar' ? 'rtl' : 'ltr';
  }
  siteLanguage.addEventListener('change', () => {
    const language = siteLanguage.value;
    languageStatus.textContent = language === 'ar' ? 'جارٍ الرجوع إلى العربية…' : 'جارٍ تطبيق الترجمة…';
    setTranslateCookie(language);
    if (language === 'ar') {
      // Clear common Google Translate cookies and reload the original Arabic page.
      document.cookie = 'googtrans=;path=/;max-age=0';
      document.cookie = 'googtrans=;path=/;domain=' + location.hostname + ';max-age=0';
    }
    setTimeout(() => location.reload(), 120);
  });
  syncLanguageChoice();

</script>
<script>window.googleTranslateElementInit = googleTranslateElementInit;</script>
<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body>
